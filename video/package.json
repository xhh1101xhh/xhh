{
  "name": "yu-xia-video",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "analyze": "python3 scripts/analyze_beats.py",
    "sync": "python3 scripts/sync_timeline.py && python3 scripts/build_fonts.py",
    "audio:preview": "python3 scripts/build_audio.py --preview",
    "audio:full": "python3 scripts/build_audio.py",
    "prep:preview": "npm run analyze && npm run sync && npm run audio:preview",
    "studio": "remotion studio src/index.ts",
    "render:preview": "npm run prep:preview && remotion render src/index.ts Preview out/preview.mp4 --codec h264 --crf 18 --audio-codec aac --audio-bitrate 320k",
    "check": "python3 scripts/check_frames.py out/preview.mp4",
    "tsc": "tsc"
  },
  "keywords": [],
